{
    // JSONC: コメントも書ける
    "app": {
        "log_level": "warn",
        "log_output": "stdout"
    },
    "cluster": {
        "name": "staging-cluster",
        "node_count": 3
    },
    "serve": {
        "host": "0.0.0.0",
        "port": 9091,
        "workers": 4
    },
    "connect": {
        "endpoint": "json.example.com:9001",
        "timeout_ms": 2000,
        "retry": {
            "count": 5,
            "interval_ms": 200
        }
    }
}
